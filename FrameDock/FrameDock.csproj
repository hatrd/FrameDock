<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\FrameDock.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameDock.Tests" />
    <EmbeddedResource Include="Assets\FrameDock.ico" LogicalName="FrameDock.BrandIcon" />
  </ItemGroup>

</Project>
